# ============================================================
# HealWell Backend Configuration Example
# ============================================================
#
# This file documents all configuration options.
# Copy to .env and adjust for your environment.
#
# Load order: .env file → environment variables → defaults
# ============================================================

# ========== CORE ==========
ENVIRONMENT=development
DEBUG=True
API_TITLE=HealWell API
API_VERSION=0.6.0

# ========== DEPLOYMENT ==========
HOST=0.0.0.0
PORT=8000

# ========== FRONTEND URLS ==========
FRONTEND_URL=http://localhost:5173
FRONTEND_STAGING_URL=http://localhost:5173
FRONTEND_PRODUCTION_URL=https://healwell.vercel.app

# ========== CORS ==========
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.6:5173
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ========== API ==========
API_HEALTH_CHECK_PATH=/health
API_PREFIX=/api/v1

# ========== AI/GEMINI (v0.7+) ==========
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT=30
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.7

# ========== LLM PROVIDER (v0.7+) ==========
# Provider selection: openai | gemini
LLM_PROVIDER=openai

# OpenAI-compatible API endpoint (e.g., Aerolink gateway)
LLM_BASE_URL=https://api.openai.com/v1

# API key for the LLM provider
LLM_API_KEY=

# Model name (e.g., gpt-4, gpt-3.5-turbo)
LLM_MODEL=gpt-4

# Request timeout in seconds
LLM_TIMEOUT=30

# ========== DATABASE (v0.9+) ==========
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ========== LOGGING ==========
LOG_LEVEL=INFO
LOG_FORMAT=json
